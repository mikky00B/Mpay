# Mpay configuration — copy to .env and adjust.
# Never commit the real .env (it is gitignored). Rotate any key that leaks.

# --- Database [D3] ---
# SQLite for local dev; use Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/mpay
DATABASE_URL=sqlite:///./mpay.db

# --- Chain / watcher [D5][D6] ---
# Hot wallet that receives all USDC payments. MUST match the watcher's
# RECEIVING_ADDRESS or payments will never match an invoice.
RECEIVING_ADDRESS=0x0000000000000000000000000000000000000000
# USDC contract (Ethereum mainnet). For Sepolia testnet, use the testnet
# USDC/equivalent contract address instead.
USDC_CONTRACT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# Shared secret between the watcher and the internal ingest API.
# MUST match the watcher's INTERNAL_API_KEY.
INTERNAL_API_KEY=change-me
# Confirmations required before an invoice flips CONFIRMING -> CONFIRMED.
CONFIRMATION_THRESHOLD=12

# --- Invoice lifecycle ---
INVOICE_TTL_MINUTES=60

# --- Chain access (confirmation sweep) ---
# JSON-RPC endpoint (Alchemy/Infura). Empty = offline mode (tests only).
RPC_URL=

# --- Webhooks [D8] ---
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_SECONDS=2.0
WEBHOOK_BACKOFF_CAP_SECONDS=60.0
WEBHOOK_TIMEOUT_SECONDS=10.0

# --- Watcher (read by the Go binary, not the API) ---
# RPC_URL, API_URL, INTERNAL_API_KEY, RECEIVING_ADDRESS, USDC_CONTRACT,
# CONFIRMATIONS, POLL_SECONDS, MAX_BLOCKS, STATE_FILE
